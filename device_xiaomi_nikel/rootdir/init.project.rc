# nikel project init (replaces SHIFT5me's init.project.rc: SHIFT's KTD2037 LED
# and SX9310 SAR sensor do not exist on nikel)
on init
    mkdir /mnt/media_rw/usbotg 0700 media_rw media_rw
    mkdir /storage/usbotg 0700 root root

on post-fs-data
    # Camera autofocus nodes (nikel stock: MAINAF on i2c2, SUBAF on i2c3)
    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF
    chmod 0660 /dev/SUBAF
    chown system camera /dev/SUBAF

    # Touch-key backlight (MTK leds class)
    chmod 0660 /sys/class/leds/button-backlight/brightness
    chown system system /sys/class/leds/button-backlight/brightness

service fuse_usbotg /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/usbotg /storage/usbotg
    class late_start
    disabled
