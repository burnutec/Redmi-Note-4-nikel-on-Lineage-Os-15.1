<resources>
    <!-- Hardware keys: home (1) + back (2) + app switch (16) = 19 -->
    <integer name="config_deviceHardwareKeys">19</integer>
    <integer name="config_deviceHardwareWakeKeys">0</integer>

    <!-- RGB LED for notifications (1) + battery (2), blinking (8) = 11.
         Without this, Lineage never turns on the charging/notification LED. -->
    <integer name="config_deviceLightCapabilities">11</integer>
</resources>
