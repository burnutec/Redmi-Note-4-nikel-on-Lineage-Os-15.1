<resources>

    <!-- Capacitive keys: no on-screen navigation bar by default -->
    <bool name="config_showNavigationBar">false</bool>

    <!-- Notification LED (RGB, MTK leds class) -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!-- Adaptive brightness: LTR-579 light sensor (kernel ltr579 driver) -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Lux steps; the backlight list has one more entry (0..255) -->
    <integer-array name="config_autoBrightnessLevels">
        <item>2</item>
        <item>10</item>
        <item>30</item>
        <item>80</item>
        <item>200</item>
        <item>400</item>
        <item>800</item>
        <item>1500</item>
        <item>3000</item>
        <item>5000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>8</item>
        <item>16</item>
        <item>30</item>
        <item>50</item>
        <item>80</item>
        <item>110</item>
        <item>150</item>
        <item>190</item>
        <item>225</item>
        <item>245</item>
        <item>255</item>
    </integer-array>

    <!-- Lowest backlight in auto mode (dark room) -->
    <integer name="config_screenBrightnessDark">4</integer>

    <!-- 4100 mAh -->
    <integer name="config_lowBatteryWarningLevel">15</integer>
</resources>
