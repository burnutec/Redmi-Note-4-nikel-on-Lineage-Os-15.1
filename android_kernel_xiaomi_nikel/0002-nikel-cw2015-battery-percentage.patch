+#if defined(CONFIG_MTK_BQ24296_SUPPORT)
+/* nikel: battery percentage from the CW2015 gauge (nikel_cw2015.c, read-only) */
+extern int nikel_cw2015_get_soc(int *soc, int mtk_soc);
+#endif
+
+/*
+ * nikel: MediaTek's algorithm always runs (keeps its coulomb-counter state
+ * consistent); when the CW2015 reports a valid value, that value is used, as
+ * on stock nikel. Otherwise MediaTek's own percentage is returned unchanged.
+ */
+signed int battery_meter_get_battery_percentage(void)
+{
+	signed int mtk_soc = mtk_battery_meter_get_battery_percentage();
+#if defined(CONFIG_MTK_BQ24296_SUPPORT) && !defined(CONFIG_POWER_EXT)
+	int cw_soc;
+
+	if (nikel_cw2015_get_soc(&cw_soc, mtk_soc) == 0)
+		return cw_soc;
+#endif
+	return mtk_soc;
+}
