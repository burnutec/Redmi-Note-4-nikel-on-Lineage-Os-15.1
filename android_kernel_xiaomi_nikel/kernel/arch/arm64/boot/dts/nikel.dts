/*
 * Redmi Note 4 (MTK, "nikel") - board device tree
 * Target: SHIFTPHONES/android_kernel_shift_mt6797 (shift-8.0-mtk, 3.18.60)
 * Built as CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="nikel" (nikel_defconfig),
 * one merged DTB appended to the kernel, no odmdtbo (nikel's LK has none).
 *
 * GENERATED DRAFT. Built by diffing nikel's stock DTB (Xiaomi kernel
 * 3.18.M2+, 2019-04-19, taken from a LineageOS 14.1 boot.img) against the
 * SoC tree inside SHIFT5ME.SOS.2.0.L.20230421's boot.img. Only what nikel's
 * board needs on top of SHIFT's mt6797.dtsi is here.
 *
 * Rules used:
 *  - Board data (pins, I2C/SPI devices, EINTs, touch, keypad, LEDs, sensors,
 *    camera power, LCM pins, battery tables) = nikel stock, verbatim.
 *  - SoC/kernel-version data (clock IDs, driver compatibles, I2C PM flags)
 *    = SHIFT, untouched.
 *  - Firmware-tied data (TEE interrupts, modem CCIF) = nikel, because nikel
 *    keeps its own TEE and modem images.
 *  - Phandles rewritten: SHIFT labels where they exist, otherwise generated
 *    "nk_*" labels on nikel's own pin-state nodes.
 *
 * Not yet compiled. First test: build with the kernel's dtc, then compare the
 * result against nikel's stock DTB with the same diff script.
 */

/dts-v1/;

/*
 * SHIFT's MT6797 SoC description - the same file SHIFT5me.dts includes when
 * CONFIG_MTK_DTBO_FEATURE is off, and the source of the base DTB this board
 * file was diffed against.
