				    0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
			mediatek,kpd-pwrkey-eint-gpio = <0x0>;
			mediatek,kpd-pwkey-gpio-din = <0x0>;
			mediatek,kpd-hw-dl-key0 = <0x11>;
			mediatek,kpd-hw-dl-key1 = <0x0>;
			mediatek,kpd-hw-dl-key2 = <0x8>;
			mediatek,kpd-hw-recovery-key = <0x11>;
			mediatek,kpd-hw-factory-key = <0x0>;
			status = "okay";
		};
		bat_metter {
			/delete-property/ ac_charger_input_current;
			/delete-property/ mtk_pump_express_plus_support;
			/delete-property/ ta_start_battery_soc;
			/delete-property/ ta_stop_battery_soc;
			/delete-property/ ta_ac_12v_input_current;
			/delete-property/ ta_ac_9v_input_current;
			/delete-property/ ta_ac_7v_input_current;
			/delete-property/ ta_ac_charging_current;
			/delete-property/ ta_9v_support;
			/delete-property/ ta_12v_support;
			charging_full_current = <0x104>;
			ac_charger_current = <0x13880>;
			bat_low_temp_protect_enable = <0x0>;
			/*
			 * nikel: stock DT says 0, but the stock kernel never reads this property
			 * (compile-time HIGH_BATTERY_VOLTAGE_SUPPORT) and charges the 4.4 V cell to
			 * 4.37 V "Full". SHIFT's battery_common.c does read it, so 1 here reproduces
			 * stock: framework requests 4.34 V, BQ24296 driver maps it to 4.400 V (0x38).
			 */
			high_battery_voltage_support = <0x1>;
			/*
			 * Battery thermistor (NTC). The stock DT carries MediaTek's generic
			 * 10k NTC / 24k pull-up to 1.8 V, but the stock KERNEL uses compiled-in
			 * values: 68k NTC table (found in the stock Image) with a 100k pull-up
			 * to 2.8 V. Proof from stock sysfs: TEMPBATTVOLTAGE=943 mV ->
			 * 100000*943/(2800-943) = 50780 ohm = stock's TEMPERATURER -> 31 C.
			 * With the generic values our kernel read about -4 C and JEITA
			 * blocked charging.
			 */
			rbat_pull_up_r = <100000>;
			rbat_pull_up_volt = <2800>;
			/* negative temperatures as two's complement: 0xffffffec = -20 ... */
			batt_temperature_table_num = <17>;
			batt_temperature_table = <
				0xffffffec 667700  0xfffffff1 502600  0xfffffff6 381700  0xfffffffb 292300
				0 225400  5 175100  10 136900  15 107800  20 85350
				25 68000  30 54500  35 43930  40 35610  45 29020
				50 23770  55 19580  60 16200>;
