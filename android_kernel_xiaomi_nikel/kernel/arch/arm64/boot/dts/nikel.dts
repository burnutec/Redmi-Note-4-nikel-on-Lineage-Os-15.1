	};
	led@5 {
		compatible = "mediatek,button-backlight";
		/*
		 * nikel stock: mode 2 (GPIO) with data = 1. In SHIFT's LED driver,
		 * GPIO mode calls "data" as a function -> jump to address 0x1, kernel
		 * panic as soon as TWRP lit the key backlight (test boot #2). Xiaomi
		 * drove the key backlight with custom code (button_backlight0/1 pin
		 * states). Off until a small GPIO handler is ported.
		 */
		led_mode = <0x0>;
		data = <0x1>;
		pwm_config = <0x0 0x0 0x0 0x0 0x0>;
	};
