			pinctrl-19 = <&nk_aud_extamp_high>;
			pinctrl-20 = <&nk_aud_extamp_low>;
			/*
			 * SHIFT's AudDrv_Gpio.c renames the headphone de-pop states to
			 * "*_e2" when LK reports an FAN53526 buck (nikel's LK does:
			 * extbuck_fan53526_exist = 1). Without these names the lookup
			 * fails and the driver BUG()s on the first audio playback
			 * (first Lineage boot: kernel panic in AudDrv_GPIO_Select).
			 * Same pins as hpdepop-pullhigh/-pulllow.
			 */
			pinctrl-21 = <&nk_audhpdepophigh>;
			pinctrl-22 = <&nk_audhpdepoplow>;
			status = "okay";
