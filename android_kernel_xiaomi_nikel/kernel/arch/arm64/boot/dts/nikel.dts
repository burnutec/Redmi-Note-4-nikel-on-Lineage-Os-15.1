	 * SHIFT5me_mt6797.dts declares early-mount entries here for system
	 * (non-A/B, with verity), vendor and optionally odm. nikel has no vendor
	 * or odm partition and mounts system from its normal fstab: without this
	 * deletion Android 8 init tries the early mounts and stops.
	 */
	/delete-node/ firmware;

	/*
	 * Panel pins for the nt35596_fhd_tianma_phantom driver, which drives
	 * reset, bias and backlight-enable itself (SHIFT's display driver only
