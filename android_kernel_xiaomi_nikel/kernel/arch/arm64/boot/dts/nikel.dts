		scpdvfs@0 {
			pinctrl-names = "default", "scp_gpio_off", "scp_gpio_on";
			pinctrl-0 = <&nk_default>;
			pinctrl-1 = <&nk_scp_gpio_off>;
			pinctrl-2 = <&nk_scp_gpio_on>;
			status = "okay";
		};
		ap2c2k_ccif@1020b000 {
			ccif,capability = <0x0>;
		};
		adc_hw@11001000 {
			adc_channel@ {
				compatible = "mediatek,adc_channel";
				mediatek,temperature0 = <0x0>;
				mediatek,temperature1 = <0x1>;
				mediatek,adc_fdd_rf_params_dynamic_custom_ch = <0x2>;
				status = "okay";
			};
		};
		i2c@11007000 {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			clock-frequency = <0x61a80>;
			mediatek,use-open-drain;
			sw_charger@6b {
				compatible = "mediatek,sw_charger";
				reg = <0x6b>;
				status = "okay";
			};
			i2c_lcd_bias@3e {
				compatible = "mediatek,i2c_lcd_bias";
				reg = <0x3e>;
				status = "okay";
			};
			buck_boost@70 {
				compatible = "mediatek,buck_boost";
				reg = <0x70>;
				status = "okay";
			};
			strobe_main@63 {
				compatible = "mediatek,strobe_main";
				reg = <0x63>;
				status = "okay";
			};
			speaker_amp@34 {
				compatible = "mediatek,speaker_amp";
				reg = <0x34>;
				status = "okay";
			};
		};
		i2c@11008000 {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			clock-frequency = <0x61a80>;
			mediatek,use-open-drain;
			usb_type_c@3d {
				compatible = "mediatek,usb_type_c";
				reg = <0x3d>;
				status = "okay";
			};
			msensor@2e {
				compatible = "mediatek,msensor";
				reg = <0x2e>;
				status = "okay";
				/* nikel: YAS537 (stock cust_mag: yamaha537, direction 2).
				 * Can be changed live: echo 0..7 > .../msensor/layout */
				i2c_num = <1>;
				i2c_addr = <0x2e 0>;
				direction = <2>;
				power_id = <0xffff>;
				power_vol = <0>;
				is_batch_supported = <0>;
			};
			gyro@69 {
				compatible = "mediatek,gyro";
				reg = <0x69>;
				status = "okay";
				/* nikel: placeholder client only; the gyro driver talks
				 * to the BMI160 at 0x68 through the accel driver */
				i2c_num = <1>;
				direction = <1>;	/* as stock cust_gyro (mediatek,bmi160_gyro) */
				power_id = <0xffff>;
				power_vol = <0>;
				firlen = <0>;
				is_batch_supported = <0>;
			};
			gsensor@68 {
				compatible = "mediatek,gsensor";
				reg = <0x68>;
				status = "okay";
				/* nikel: BMI160 (accel + gyro in one chip). direction
				 * maps chip axes to the screen; tune after first test */
				i2c_num = <1>;
				i2c_addr = <0x68 0 0 0>;
				direction = <1>;	/* tested on the phone: 3 (stock value) swaps left/right */
				power_id = <0xffff>;
				power_vol = <0>;
				firlen = <0>;
				is_batch_supported = <0>;
			};
			barometer@77 {
				compatible = "mediatek,barometer";
				reg = <0x77>;
				status = "okay";
			};
			alsps@53 {
				compatible = "mediatek,alsps";
				reg = <0x53>;
				status = "okay";
				/* nikel: LTR-579, values from the stock cust_alsps node.
				 * The driver uses 15 levels / 16 values, so the stock
				 * 18-step table is thinned to keep its full range. */
				i2c_num = <1>;
				i2c_addr = <0x53 0 0 0>;
				power_id = <0xffff>;
				power_vol = <0>;
				polling_mode_ps = <1>;
				polling_mode_als = <1>;
				als_level = <1 4 10 30 120 255 380 650 900 1350 2200 3500 6000 20000 50000>;
				als_value = <0 5 10 30 80 225 320 550 800 1250 2000 3000 5000 7500 24000 30000>;
				ps_threshold_high = <0x3c>;
				ps_threshold_low = <0x28>;
				is_batch_supported_ps = <0>;
				is_batch_supported_als = <0>;
			};
			humidity@5f {
				compatible = "mediatek,humidity";
				reg = <0x5f>;
				status = "okay";
			};
			chargepump@62 {
				compatible = "mediatek,chargepump";
				reg = <0x62>;
				status = "okay";
			};
			msensor1@0d {
				compatible = "mediatek,msensor1";
				reg = <0xd>;
				status = "okay";
			};
		};
